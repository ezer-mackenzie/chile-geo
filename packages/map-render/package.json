{
  "name": "@chile-geo/maps",
  "version": "0.5.0",
  "description": "Typed Canvas and Three.js maps for Chilean geographic analytics",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./2d": { "types": "./dist/2d.d.ts", "import": "./dist/2d.js" },
    "./3d": { "types": "./dist/3d.d.ts", "import": "./dist/3d.js" },
    "./geography": { "types": "./dist/geography.d.ts", "import": "./dist/geography.js" },
    "./regions": { "types": "./dist/regions.d.ts", "import": "./dist/regions.js" },
    "./types": { "types": "./dist/types/index.d.ts", "import": "./dist/types.js" }
  },
  "scripts": {
    "build": "vite build --mode main && vite build --mode modules",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <0.186.0"
  },
  "peerDependenciesMeta": { "three": { "optional": true } },
  "devDependencies": { "three": "^0.185.1" },
  "files": ["dist", "README.md"],
  "keywords": ["chile", "map", "canvas", "threejs", "geojson", "typescript", "visualization"],
  "author": "Eli-ezer Reuven Ramirez Ruiz",
  "sideEffects": false,
  "license": "MIT",
  "engines": { "node": ">=18.0.0" },
  "publishConfig": { "access": "public", "provenance": true }
}
